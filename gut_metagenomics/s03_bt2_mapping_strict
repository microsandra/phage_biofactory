#!/bin/sh
##Directives start with ”#$”
#$ -cwd
#$ -V
#$ -S /bin/bash
#$ -pe openmpi 10


source ~/.bashrc

# Activate the bowtie2 environment
conda activate bowtie2_env

# Define the input directory containing the strictly filtered reads
INPUT_DIR="02_biofactory_strictfastp"

# Define a new, specific output directory for these mapping results
OUTPUT_DIR="03_mapped_insect_strict"

# Create the output directory if it doesn't exist
mkdir -p ${OUTPUT_DIR}

# Loop through all the R1 files in the strict-filtered directory
for R1_FILE in ${INPUT_DIR}/*_1.trimmed.fastq.gz; do

    # Define the corresponding R2 file by replacing _1 with _2
    R2_FILE=${R1_FILE/_1.trimmed.fastq.gz/_2.trimmed.fastq.gz}
    
    # Get the base name of the sample (e.g., "Larva_01")
    # This now correctly removes the "_1.trimmed.fastq.gz" suffix
    SAMPLENAME=$(basename "${R1_FILE}" _1.trimmed.fastq.gz)
    
    # Print which sample we are processing
    echo "--- Processing sample: ${SAMPLENAME} ---"
    echo "R1 file: ${R1_FILE}"
    echo "R2 file: ${R2_FILE}"
    echo "Output SAM: ${OUTPUT_DIR}/${SAMPLENAME}.sam"
    
    # Run the bowtie2 alignment command
    bowtie2 \
        -x 03_bowtie_index/BSF_index \
        -1 ${R1_FILE} \
        -2 ${R2_FILE} \
        -S ${OUTPUT_DIR}/${SAMPLENAME}.sam \
        --threads 10

    echo "--- Finished sample: ${SAMPLENAME} ---"
 
done

echo "Bowtie2 mapping complete for all samples."


